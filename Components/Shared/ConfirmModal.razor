@using Microsoft.AspNetCore.Components

@if (IsVisible)
{
    <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:1040" @onclick="Cancel"></div>

    <div style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:1050;min-width:320px;max-width:480px;width:90%">
        <div class="card shadow-lg">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"> @Title</h5>
            </div>
            <div class="card-body">
                <p class="mb-0">@Message</p>
            </div>
            <div class="card-footer d-flex gap-2 justify-content-end">
                <button class="btn btn-secondary" @onclick="Cancel">
                    Үгүй
                </button>
                <button class="btn btn-danger" @onclick="Confirm">
                    Тийм
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public string Title { get; set; } = "Устгах";

    [Parameter]
    public string Message { get; set; } = "Та устгахдаа итгэлтэй байна уу?";

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private async Task Confirm() => await OnConfirm.InvokeAsync();

    private async Task Cancel() => await OnCancel.InvokeAsync();
}
